#X msg 240 530 1 10;
#X obj 180 580 delay 20;
#X msg 180 605 0;
#X obj 120 500 t b b;
#X obj 20 250 table organ-params 16;
#X obj 20 200 loadbang;
#X obj 20 160 expr~ \$v1*(1-\$f3*(0.5+0.5*\$v2));
#X obj 150 100 r organ-trem;
#X obj 150 125 unpack f f;
#X obj 150 150 osc~;
#X text 20 300 Drawbar organ (4 voices). Banks: 19 Jazz organ \, 20 Gospel organ \, 21 Church organ. DSP is switched off when another instrument is selected.;
#X text 20 360 organ-params: 0-8 drawbars 0-8 (16' 5 1/3' 8' 4' 2 2/3' 2' 1 3/5' 1 1/3' 1') \, 9 percussion level \, 10 percussion harmonic (4 = 2nd \, 6 = 3rd) \, 11 percussion decay ms \, 12 attack ms (5 or more) \, 13 release ms \, 14 gain \, 15 octave. organ-trem: Leslie-style tremolo rate Hz and depth 0-1.;
