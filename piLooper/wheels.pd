#N canvas 50 50 700 400 10;
#X text 20 5 Pitch bend + mod wheel. See tools/gen_wheels.py (this file is generated).;
#X obj 20 55 expr (\$f1-8192)/8192*12;
#X obj 20 30 bendin;
#X obj 100 30 r wheels-test-bend;
#X obj 20 80 t f f;
#X msg 20 105 \$1 10;
#X obj 20 130 line~;
#X obj 150 105 expr pow(2 \, \$f1/12);
#X obj 150 130 s pitchbend-ratio;
#X obj 250 55 expr \$f1/127;
#X obj 250 30 ctlin 1;
#X obj 330 30 r wheels-test-mod;
#X msg 250 80 \$1 30;
#X obj 250 105 line~;
#X obj 400 105 osc~ 5.5;
#X obj 20 180 expr~ pow(2 \, (\$v1 + \$v2*0.5*\$v3)/12);
#X obj 20 210 s~ pitchmod;
